{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "标准检索台",
  "version": "0.1.0",
  "identifier": "com.niaoge.standard-search",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist-web"
  },
  "app": {
    "windows": [
      {
        "title": "标准检索台",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../data": "data"
    }
  }
}
