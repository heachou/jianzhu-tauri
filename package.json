{
  "name": "niaoge-standard-search",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:crawler",
    "build:crawler": "tsc -p tsconfig.json",
    "build:web": "tsc -p tsconfig.frontend.json && vite build",
    "crawl": "npm run build:crawler && node dist/crawler.js",
    "crawl:dry-run": "npm run build:crawler && node dist/crawler.js --dry-run",
    "dev": "vite --host 127.0.0.1",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.0.0",
    "vite": "^5.4.0"
  }
}
